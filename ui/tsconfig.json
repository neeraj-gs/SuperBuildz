{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@scenes/*": ["../design-library/scenes/*"],
      "@superbuilds/protocol": ["../packages/protocol/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "../design-library/scenes", "../packages/protocol/src"],
  "//exclude": "loaders.ts resolves `@/components/scenes/*`, which only exists once the scaffold has copied this folder into a generated site. It is shipped, not compiled here.",
  "exclude": ["../design-library/scenes/loaders.ts"]
}
