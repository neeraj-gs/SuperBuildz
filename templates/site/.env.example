# Copy of the shape Super Builds writes into .env.local. Values are never committed.
SITE_NAME="Your Site"
SESSION_SECRET=change-me-32-bytes-base64url
ADMIN_EMAIL=owner@localhost
ADMIN_PASSWORD_HASH=scrypt:32768:...:...
# Leave unset locally: SQLite in data/site.db is used. Set a Postgres URL (Neon, Supabase) before deploying.
# DATABASE_URL=postgres://...
NEXT_PUBLIC_ANALYTICS=custom,vercel
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# RESEND_API_KEY=
# CONTACT_EMAIL=
